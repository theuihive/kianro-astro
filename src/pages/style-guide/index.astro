---
import HomeContactSection from "@/components/contact/HomeContactSection.astro";
import Button from "@/components/ui/Button.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const colors = [
  { name: "Dark Primary", token: "--color-dark-primary", hex: "#0E0E0E", swatch: "bg-dark-primary" },
  { name: "White", token: "white", hex: "#FFFFFF", swatch: "bg-white" },
  { name: "Primary", token: "--color-primary", hex: "#ECFDAD", swatch: "bg-primary" },
  { name: "Dark Shades 90", token: "--color-dark-shades-90", hex: "#151515", swatch: "bg-dark-shades-90" },
  { name: "Dark Shades 80", token: "--color-dark-shades-80", hex: "#202020", swatch: "bg-dark-shades-80" },
  { name: "Stroke", token: "--color-stroke", hex: "#262626", swatch: "bg-stroke" },
  { name: "Dark Shades 70", token: "--color-dark-shades-70", hex: "#484848", swatch: "bg-dark-shades-70" },
  { name: "Dark Shades 60", token: "--color-dark-shades-60", hex: "#666666", swatch: "bg-dark-shades-60" },
  { name: "Dark Shades 50", token: "--color-dark-shades-50", hex: "#B9B8B8", swatch: "bg-dark-shades-50" },
  { name: "Dark Shades 30", token: "--color-dark-shades-30", hex: "#DBD7D7", swatch: "bg-dark-shades-30" },
  { name: "Dark Shades 20", token: "--color-dark-shades-20", hex: "#E6E4E4", swatch: "bg-dark-shades-20" },
];

const headingScale = [
  { label: "D1", size: "240/100", weight: "Semi Bold", class: "text-[56px] sm:text-[100px] md:text-[160px] lg:text-[240px] font-jersey leading-none tracking-[-4%] uppercase" },
  { label: "H1", size: "80/80", weight: "Regular", class: "text-4xl sm:text-6xl lg:text-[80px] font-jersey leading-[80%] tracking-[-4%] uppercase" },
  { label: "H2", size: "64/90", weight: "Regular", class: "text-3xl sm:text-5xl lg:text-[64px] font-jersey leading-[90%] tracking-[-3%] uppercase" },
  { label: "H3", size: "40/100", weight: "Regular", class: "text-2xl sm:text-[40px] font-jersey leading-none tracking-[-2%] uppercase" },
  { label: "H4", size: "24/150", weight: "Medium", class: "text-2xl font-switzer font-medium leading-normal tracking-[-1%]" },
  { label: "H5 (Semibold)", size: "20/150", weight: "Semibold", class: "text-xl font-switzer font-semibold leading-normal tracking-[-1%]" },
  { label: "H5 (Medium)", size: "20/150", weight: "Medium", class: "text-xl font-switzer font-medium leading-normal tracking-[-1%]" },
];

const bodyScale = [
  { label: "Body L", size: "18/150", weight: "Regular", class: "text-lg font-switzer font-normal leading-normal tracking-[-1%]" },
  { label: "Body R (Medium)", size: "16/150", weight: "Medium", class: "text-base font-switzer font-medium leading-normal tracking-[-1%]" },
  { label: "Body R (Medium Uppercase)", size: "16/150", weight: "Medium Uppercase", class: "text-base font-switzer font-medium leading-normal uppercase" },
  { label: "Body R (Regular)", size: "16/150", weight: "Regular", class: "text-base font-switzer font-normal leading-normal" },
  { label: "Body S (Button Text)", size: "14/150", weight: "Semibold", class: "text-sm font-switzer font-semibold leading-normal uppercase" },
  { label: "Body S (Medium)", size: "14/150", weight: "Medium", class: "text-sm font-switzer font-medium leading-normal uppercase" },
];
---

<MainLayout title="Style Guide" description="Design tokens (colors, typography, buttons) used across the site.">
  <div class="py-15 md:py-24 lg:py-32">
    <div class="container">
      <h1 class="font-jersey text-5xl sm:text-6xl lg:text-[80px] leading-[80%] tracking-[-4%] uppercase text-white text-center mb-16 md:mb-24">Style Guide</h1>

      <!-- Color Palette -->
      <section class="mb-16">
        <h2 class="font-jersey text-3xl lg:text-5xl xl:text-[64px] tracking-[-3%] uppercase text-white mb-8">Color Palette</h2>

        <div class="grid grid-cols-4 sm:grid-cols-6 gap-4 sm:gap-6">
          {
            colors.map((color) => (
              <div>
                <div class={`aspect-square w-full rounded-sm border border-white/10 ${color.swatch}`} />
                <p class="mt-3 text-xs sm:text-sm text-dark-shades-50">{color.hex}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Typography -->
      <section class="mb-16 md:mb-24">
        <h2 class="font-jersey text-3xl lg:text-5xl xl:text-[64px] tracking-[-3%] uppercase text-white mb-8">Typography (Jersey 20 &amp; Switzer Variable)</h2>

        <!-- Heading Scale -->
        <div class="overflow-x-auto mb-16">
          <div class="w-full min-w-150">
            <div class="grid grid-cols-[1fr_1fr_1fr] gap-6 bg-dark-shades-90 px-4 py-3 text-xs font-medium uppercase tracking-wide text-dark-shades-50">
              <span>Heading</span>
              <span>Size (px)</span>
              <span>Weight</span>
            </div>

            <div class="">
              {
                headingScale.map((row) => (
                  <div class="grid grid-cols-[1fr_1fr_1fr] gap-6 px-4 py-6 md:py-6 items-start">
                    <span class={`${row.class} text-white min-w-0 wrap-break-word`}>{row.label}</span>
                    <span class={`${row.class} text-white min-w-0 wrap-break-word`}>{row.size}</span>
                    <span class={`${row.class} text-white min-w-0 wrap-break-word`}>{row.weight}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Body Text Scale -->
        <div class="overflow-x-auto">
          <div class="w-full min-w-150">
            <div class="grid grid-cols-[1fr_1fr_1fr] gap-6 bg-dark-shades-90 px-4 py-3 text-xs font-medium uppercase tracking-wide text-dark-shades-50">
              <span>Body Text</span>
              <span>Size (px)</span>
              <span>Weight</span>
            </div>

            <div class="">
              {
                bodyScale.map((row) => (
                  <div class="grid grid-cols-[1fr_1fr_1fr] gap-6 px-4 py-4 md:py-4 items-center">
                    <span class={`${row.class} text-white min-w-0 wrap-break-word`}>{row.label}</span>
                    <span class={`${row.class} text-white min-w-0 wrap-break-word`}>{row.size}</span>
                    <span class={`${row.class} text-white min-w-0 wrap-break-word`}>{row.weight}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Buttons -->
      <section>
        <h2 class="text-lg font-semibold uppercase text-white mb-8">Button</h2>

        <div class="flex flex-wrap items-center gap-6">
          <Button href="/services">View All Services</Button>
          <Button href="/services" variant="outline">View All Services</Button>
        </div>
      </section>
    </div>
  </div>

  <HomeContactSection />
</MainLayout>
