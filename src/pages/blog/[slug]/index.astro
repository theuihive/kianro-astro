---
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<MainLayout title={post.data.title || "Article details | Premium Portfolio Theme"} description={post.data.description}>
  <div class="py-15 md:py-24 lg:py-32">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <div class="flex justify-center items-center gap-3 mb-2">
          <div class="text-dark-shades-50 text-lg tracking-[-1%]">
            {post.data.category.name}
          </div>
          <div class="hidden md:block bg-dark-shades-50 size-1 rounded-full"></div>
          <div class="text-dark-shades-50 text-lg tracking-[-1%]">6 Min Read</div>
        </div>
        <h1 class="font-jersey text-5xl md:text-6xl lg:text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">{post.data.title}</h1>
      </div>
      <div class="h-full md:h-120 lg:h-185 overflow-hidden mt-10">
        <img src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover" />
      </div>
      <div
        class="pt-20 prose max-w-218 mx-auto text-white prose-h2:text-white prose-h2:sm:text-[40px] prose-h2:uppercase prose-h2:tracking-[-2%] prose-h2:leading-none prose-h2:font-normal prose-h2:font-jersey prose-h2:mb-3 prose-h2:mt-10 prose-p:text-dark-shades-50 prose-p:text-lg prose-p:tracking-[-1%] prose-h3:text-white prose-h3:text-xl prose-h3:mt-0 prose-h3:tracking-[-1%] prose-h3:font-semibold prose-h3:mb-2"
      >
        <Content />
      </div>
    </div>
  </div>
</MainLayout>
