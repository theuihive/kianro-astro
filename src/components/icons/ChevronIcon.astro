---
interface Props {
  size?: number | string;
  color?: string;
  direction?: "right" | "left" | "up" | "down";
}

const { size = 24, color = "currentColor", direction = "right" } = Astro.props;

const rotation = {
  up: "rotate(0 12 12)",
  right: "rotate(90 12 12)",
  down: "rotate(180 12 12)",
  left: "rotate(270 12 12)",
};
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <g transform={rotation[direction]}>
    <path d="M6 15L12 9L18 15" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </g>
</svg>
