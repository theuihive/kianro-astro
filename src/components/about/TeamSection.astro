---
import TextReveal from "../ui/TextReveal.astro";

const members = [
  {
    id: "101",
    thumbnail: "/images/members/member-01.jpg",
    name: "Adrian Brooks",
    designation: "Founder & Creative Director",
  },
  {
    id: "102",
    thumbnail: "/images/members/member-02.jpg",
    name: "Charlotte Hayes",
    designation: "Founder & Managing Director",
  },
  {
    id: "103",
    thumbnail: "/images/members/member-03.jpg",
    name: "Alexander Cole",
    designation: "UX Lead & Creative Director",
  },
];
---

<div class="pb-15 md:pb-24 lg:pb-40 overflow-hidden" id="team-section">
  <div class="container">
    <div class="max-w-lg mx-auto text-center mb-10 md:mb-20">
      <TextReveal>
        Meet Our
        <span class="text-dark-shades-60"> Leaders</span>
      </TextReveal>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-7 md:gap-15">
      {
        members.map((member) => (
          <div class="team-member">
            <img src={member.thumbnail} alt={member.name} class="w-full" />
            <div class="pt-4">
              <h3 class="text-xl text-white font-semibold">{member.name}</h3>
              <p class="text-base text-dark-shades-50">{member.designation}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initScrollAnimation() {
    const section = document.querySelector<HTMLElement>("#team-section");
    if (!section) return;

    const members = section.querySelectorAll<HTMLElement>(".team-member");
    if (members.length === 0) return;

    gsap.from(members, {
      y: 80,
      opacity: 0,
      duration: 1,
      stagger: 0.15,
      ease: "power3.out",
      scrollTrigger: {
        trigger: section,
        start: "top 75%",
        toggleActions: "play none none none",
      },
    });
  }

  initScrollAnimation();
  document.addEventListener("astro:page-load", initScrollAnimation);
</script>
