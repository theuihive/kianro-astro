---
import BrandsTicker from "@/components/about/BrandsTicker.astro";
---

<div class="pt-35">
  <div class="container">
    <div class="grid grid-cols-2 gap-6">
      <div class="h-full">
        <div class="flex flex-col justify-between h-full xl:max-w-135">
          <h2 class="title font-jersey text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">
            Building Brands,
            <span class="text-dark-shades-60"> Websites & Digital Experiences</span>
          </h2>
          <p class="description text-lg leading-normal text-dark-shades-50 tracking-[-1%]">
            Founded with a passion for thoughtful design, our agency partners with startups, established businesses, and growing brands to create digital experiences that are visually compelling, strategically driven, and built for long-term success.
          </p>
        </div>
      </div>
      <div class="reveal-wrap relative overflow-hidden">
        <img src="/images/about/about-hero.jpg" alt="about hero" class="reveal-img w-full h-full object-cover" />
      </div>
    </div>
    <div class="ticker max-w-162 mx-auto pt-24">
      <BrandsTicker />
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  const wrap = document.querySelector<HTMLElement>(".reveal-wrap");
  const title = document.querySelector<HTMLElement>(".title");
  const description = document.querySelector<HTMLElement>(".description");
  const ticker = document.querySelector<HTMLElement>(".ticker");

  const tl = gsap.timeline();

  if (title) {
    tl.set(title, { y: 60, opacity: 0, filter: "blur(10px)" }, 0).to(title, { y: 0, opacity: 1, filter: "blur(0px)", duration: 1, ease: "power3.out" }, 0);
  }

  if (description) {
    tl.set(description, { y: -60, opacity: 0, filter: "blur(10px)" }, 0).to(description, { y: 0, opacity: 1, filter: "blur(0px)", duration: 1, ease: "power3.out" }, 0);
  }

  if (wrap) {
    tl.set(wrap, { clipPath: "inset(0% 100% 0% 0%)" }, 0).to(wrap, { clipPath: "inset(0% 0% 0% 0%)", duration: 1.4, ease: "power4.inOut" }, 0);
  }

  if (ticker) {
    tl.set(ticker, { y: 60, opacity: 0, filter: "blur(10px)" }, 0).to(ticker, { y: 0, opacity: 1, filter: "blur(0px)", duration: 1, ease: "power3.out" }, 0);
  }
</script>
