---
import Button from "@/components/ui/Button.astro";
import awardsData from "@/data/awards.json";
import type { AwardsData } from "@/types/Award";

const { heading, cta, awards } = awardsData as AwardsData;
---

<section>
  <div class="container">
    <!-- Heading -->
    <div class="mb-10 md:mb-20 flex flex-col sm:flex-row justify-between gap-6">
      <h2 class="font-jersey text-5xl md:text-6xl lg:text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">
        {heading.line1Bold}
        <br />
        <span class="text-dark-shades-60">{heading.line2Muted}</span>
      </h2>

      <div class="sm:self-end">
        <Button href={cta.href}>{cta.label}</Button>
      </div>
    </div>

    <!-- Awards list -->
    <div class="">
      {
        awards.map((item) => (
          <div class="border-b border-stroke">
            {/* --- Mobile layout (no hover) --- */}
            <div class="grid grid-cols-2 gap-x-4 gap-y-3 py-6 text-base font-medium md:hidden">
              <div class="flex flex-col gap-1">
                <span class="text-sm uppercase tracking-wide text-dark-shades-60">Year</span>
                <span>{item.year}</span>
              </div>
              <div class="flex flex-col gap-1">
                <span class="text-sm uppercase tracking-wide text-dark-shades-60">Client</span>
                <span>{item.client}</span>
              </div>
              <div class="flex flex-col gap-1">
                <span class="text-sm uppercase tracking-wide text-dark-shades-60">Award</span>
                <span>{item.award}</span>
              </div>
              <div class="flex flex-col gap-1">
                <span class="text-sm uppercase tracking-wide text-dark-shades-60">Platform</span>
                <span>{item.platform}</span>
              </div>
            </div>

            {/* ---Desktop layout ---- */}
            <div class="group relative hidden grid-cols-4 items-center gap-6 py-8 text-xl font-medium md:grid">
              <span class="pointer-events-none absolute inset-0 z-0 origin-center scale-y-0 bg-white transition-transform duration-500 ease-out group-hover:scale-y-100" aria-hidden="true" />

              <span class="relative transition-transform duration-500 ease-out group-hover:translate-x-6 group-hover:text-dark-primary">{item.year}</span>
              <span class="relative transition-transform duration-500 ease-out group-hover:translate-x-6 group-hover:text-dark-primary">{item.client}</span>
              <span class="relative transition-transform duration-500 ease-out group-hover:translate-x-6 group-hover:text-dark-primary">{item.award}</span>
              <span class="relative transition-transform duration-500 ease-out group-hover:translate-x-6 group-hover:text-dark-primary">{item.platform}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
