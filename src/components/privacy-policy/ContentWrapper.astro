---
interface Item {
  title?: string;
  subtitle?: string;
  description?: string;
}

interface Props {
  data: Item[];
  title: string;
}

const { data, title } = Astro.props;
---

<section class="py-20 md:py-24 lg:py-32">
  <div class="container">
    <div class="mb-10 md:mb-15 text-center">
      <h2 class="font-jersey text-5xl md:text-6xl lg:text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">{title}</h2>
    </div>
    <div class="max-w-218 mx-auto">
      <div class="space-y-8 md:space-y-11">
        {
          data.map((item) => (
            <div class="">
              {item.title && <h2 class="text-3xl md:text-[40px] leading-none text-white font-jersey tracking-[-2%] uppercase mb-2 sm:mb-5">{item.title}</h2>}
              {item.subtitle && <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight mb-2 sm:mb-3">{item.subtitle}</h3>}
              {item.description && <p class="text-base sm:text-lg text-dark-shades-50 leading-normal">{item.description}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
