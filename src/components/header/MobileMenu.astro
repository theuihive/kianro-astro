---
import Logo from "@/components/header/Logo.astro";
import Button from "@/components/ui/Button.astro";
import CloseIcon from "../icons/CloseIcon.astro";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;
---

<!-- Reveal Panel -->
<div id="reveal-overlay" class="fixed top-0 right-0 z-50 h-screen w-full bg-black/80 backdrop-blur-sm translate-x-full cursor-pointer"></div>

<!-- Main Menu Panel -->
<aside id="offcanvas-menu" class="fixed top-0 right-0 z-50 h-screen w-full sm:max-w-sm bg-dark-primary border-l border-stroke shadow-2xl translate-x-full flex flex-col justify-between p-6 overflow-y-auto" aria-label="Mobile Navigation">
  <div>
    <!-- Top Bar: Logo & Close Button -->
    <div class="flex items-center justify-between pb-6 border-b border-stroke/50">
      <Logo />
      <button id="menu-close-button" type="button" class="size-12 rounded-full border border-stroke flex items-center justify-center text-white hover:bg-white/10 transition-colors" aria-label="Close menu">
        <CloseIcon class="hover:rotate-45 transition-transform duration-300 size-6" />
      </button>
    </div>

    <!-- Nav Links -->
    <nav class="mt-8 flex flex-col gap-5">
      {
        navLinks.map((link) => (
          <a href={link.href} class="mobile-nav-link text-xl font-medium uppercase text-dark-shades-30 hover:text-white transition-colors duration-300">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- Bottom CTA -->
  <div class="mobile-menu-footer pt-6 border-t border-stroke/50">
    <Button href="/contact">Book a Call</Button>
  </div>
</aside>
