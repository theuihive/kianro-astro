---
import Logo from "@/components/header/Logo.astro";
import BarIcon from "@/components/icons/BarIcon.astro";
import Button from "@/components/ui/Button.astro";
import MobileMenu from "@/components/header/MobileMenu.astro";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Services", href: "/services" },
  { label: "Blog", href: "/blog" },
];
---

<header class="py-3 lg:py-6.5 bg-dark-primary border-b border-stroke" id="site-header">
  <div class="container relative">
    <div class="flex items-center justify-between gap-4">
      <!-- Logo -->
      <a href="/" class="shrink-0">
        <Logo />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-8">
        {
          navLinks.map((link) => (
            <a href={link.href} class="text-sm font-medium uppercase text-dark-shades-30 hover:text-white transition-colors duration-300">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <!-- CTA -->
        <div class="hidden md:block">
          <Button href="/contact">book a call </Button>
        </div>

        <!-- Mobile menu toggle -->
        <button
          id="mobile-menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="lg:hidden relative inline-flex shrink-0 items-center justify-center size-12 border border-stroke text-white rounded-full hover:bg-primary hover:text-dark-primary hover:border-primary transition-colors duration-300"
        >
          <span class="relative inline-flex items-center justify-center size-8">
            <BarIcon />
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- Offcanvas Component -->
  <MobileMenu navLinks={navLinks} />
</header>

<script>
  import { gsap } from "gsap";

  function initMobileMenu() {
    const openBtn = document.getElementById("mobile-menu-button");
    const closeBtn = document.getElementById("menu-close-button");
    const revealOverlay = document.getElementById("reveal-overlay");
    const offcanvasMenu = document.getElementById("offcanvas-menu");
    const navLinks = document.querySelectorAll(".mobile-nav-link");
    const menuFooter = document.querySelector(".mobile-menu-footer");

    if (!openBtn || !offcanvasMenu || !revealOverlay) return;

    const menuTl = gsap.timeline({
      paused: true,
      onReverseComplete: () => {
        openBtn.setAttribute("aria-expanded", "false");
      },
    });

    menuTl
      // Blank overlay slides
      .to(revealOverlay, {
        xPercent: -100,
        duration: 0.8,
        ease: "power3.inOut",
      })
      // Main Menu slides
      .to(
        offcanvasMenu,
        {
          xPercent: -100,
          duration: 0.4,
          ease: "power3.out",
        },
        "-=0.2",
      )
      // Stagger inner text & CTA
      .from(
        navLinks,
        {
          y: 15,
          opacity: 0,
          duration: 0.3,
          stagger: 0.04,
          ease: "power2.out",
        },
        "-=0.15",
      )
      .from(
        menuFooter,
        {
          y: 10,
          opacity: 0,
          duration: 0.25,
          ease: "power2.out",
        },
        "-=0.2",
      );

    // Open Event
    openBtn.addEventListener("click", () => {
      openBtn.setAttribute("aria-expanded", "true");
      menuTl.play();
    });

    // Close Event (Close Button)
    closeBtn?.addEventListener("click", () => {
      menuTl.reverse();
    });

    // Close Event (Overlay Click)
    revealOverlay.addEventListener("click", () => {
      menuTl.reverse();
    });

    // Navigation Link Click Event
    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const targetHref = link.getAttribute("href");

        if (targetHref && !targetHref.startsWith("#")) {
          e.preventDefault();

          menuTl.reverse();

          menuTl.eventCallback("onReverseComplete", () => {
            openBtn.setAttribute("aria-expanded", "false");
            window.location.href = targetHref;
          });
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initMobileMenu);
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
