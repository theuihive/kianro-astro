---
import ArticleCardGridStyle from "@/components/blog/ArticleCardGridStyle.astro";
import Button from "@/components/ui/Button.astro";

const { posts } = Astro.props;
---

<section class="pb-40">
  <div class="container">
    <!-- Heading -->
    <div class="mb-19">
      <div class="flex justify-between gap-7">
        <div class="max-w-xl">
          <h2 class="font-jersey text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">
            More
            <span class="text-dark-shades-60"> Insights</span>
          </h2>
        </div>
        <div class="self-end">
          <Button href="/blog">View All Insights</Button>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {posts.map((post) => <ArticleCardGridStyle post={post} />)}
    </div>
  </div>
</section>
