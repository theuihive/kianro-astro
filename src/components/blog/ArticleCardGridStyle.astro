---
import type { CollectionEntry } from "astro:content";
import Button from "../ui/Button.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<a href={`/blog/${post.id}`} data-category={post.data.category.slug} class="bg-dark-shades-90 p-2 group">
  <div class="overflow-hidden">
    <img src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
  </div>

  <div class="p-4 pt-6">
    <div class="flex items-center gap-3 mb-2">
      <div class="text-dark-shades-50 text-lg tracking-[-1%]">
        {post.data.category.name}
      </div>
      <div class="hidden md:block bg-dark-shades-50 size-1 rounded-full"></div>
      <div class="text-dark-shades-50 text-lg tracking-[-1%]">6 Min Read</div>
    </div>
    <h2 class="text-2xl md:text-[40px] leading-none text-white font-jersey tracking-[-2%] uppercase group-hover:text-primary transition-colors duration-300 mb-8">
      {post.data.title}
    </h2>

    <Button variant="outline">Read More</Button>
  </div>
</a>
