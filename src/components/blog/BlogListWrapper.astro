---
import ArticleCardGridStyle from "@/components/blog/ArticleCardGridStyle.astro";
import Button from "@/components/ui/Button.astro";
import TextReveal from "@/components/ui/TextReveal.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");

const posts = allPosts;
---

<section class="pt-15 md:pt-24 lg:pt-32" id="blog-list-section">
  <div class="container">
    <div class="mb-10 md:mb-19">
      <div class="flex flex-col md:flex-row justify-between gap-5">
        <div class="max-w-xl">
          <TextReveal>
            Creative
            <span class="text-dark-shades-60"> Thoughts & Perspectives</span>
          </TextReveal>
        </div>
        <div class="md:self-end">
          <Button href="/blog">View All Insights</Button>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-15">
      {posts.map((post) => <ArticleCardGridStyle post={post} />)}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initScrollAnimation() {
    const section = document.querySelector<HTMLElement>("#blog-list-section");
    if (!section) return;

    const cardItems = section.querySelectorAll(".blog-card-item");
    if (cardItems.length === 0) return;

    gsap.from(cardItems, {
      y: 80,
      opacity: 0,
      duration: 1,
      stagger: 0.15,
      ease: "power3.out",
      scrollTrigger: {
        trigger: section,
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
  }

  initScrollAnimation();
  document.addEventListener("astro:page-load", initScrollAnimation);
</script>
