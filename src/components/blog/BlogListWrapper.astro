---
import ArticleCardGridStyle from "@/components/blog/ArticleCardGridStyle.astro";
import Button from "@/components/ui/Button.astro";
import TextReveal from "@/components/ui/TextReveal.astro";
import { getCollection } from "astro:content";
import { getUniqueCategories } from "@/lib/blogUtils";
import LoaderIcon from "../icons/LoaderIcon.astro";

const allPosts = await getCollection("blog");
const posts = allPosts.filter((post) => !post.data.draft);
const categories = getUniqueCategories(allPosts);

const PAGE_SIZE = 6;
---

<section class="pt-15 md:pt-24 lg:pt-32" id="blog-list-section">
  <div class="container">
    <div class="mb-10 md:mb-19">
      <div class="flex flex-col md:flex-row justify-between gap-5">
        <div class="max-w-xl">
          <TextReveal>
            Creative
            <span class="text-dark-shades-60"> Thoughts & Perspectives</span>
          </TextReveal>
        </div>
        <div class="md:self-end">
          <div class="flex flex-wrap items-center gap-2 sm:gap-5">
            <button type="button" class="filter-btn is-active bg-primary text-dark-primary border-primary text-base tracking-tight font-normal px-3 sm:px-4 py-1.25 sm:py-1.75 border transition-all duration-300 ease-out" data-cat="all"> All </button>
            {
              categories.map((cat) => (
                <button type="button" class="filter-btn text-base tracking-tight font-normal px-3 sm:px-4 py-1.25 sm:py-1.75 border border-stroke hover:bg-primary hover:text-dark-primary transition-all duration-300 ease-out" data-cat={cat.slug}>
                  {cat.name}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-15" id="blog-list-grid" data-page-size={PAGE_SIZE}>
      {
        posts.map((post, index) => (
          <div class="blog-card-item" data-category={post.data.category.slug} style={index >= PAGE_SIZE ? "display:none" : undefined}>
            <ArticleCardGridStyle post={post} />
          </div>
        ))
      }
    </div>
    {
      posts.length > PAGE_SIZE && (
        <div class="mt-10 md:mt-15 flex justify-center">
          <Button id="blog-load-more" showArrow={false} variant="outline">
            Load More
            <LoaderIcon class="ml-1 size-4" />
          </Button>
        </div>
      )
    }
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initScrollAnimation() {
    const section = document.querySelector<HTMLElement>("#blog-list-section");
    if (!section) return;

    const cardItems = section.querySelectorAll(".blog-card-item");
    if (cardItems.length === 0) return;

    gsap.from(cardItems, {
      y: 80,
      opacity: 0,
      duration: 1,
      stagger: 0.15,
      ease: "power3.out",
      scrollTrigger: {
        trigger: section,
        start: "top 75%",
        toggleActions: "play none none none",
      },
    });
  }

  // Posts filter by category + load more pagination
  function initCategoryFilter() {
    const section = document.querySelector<HTMLElement>("#blog-list-section");
    if (!section) return;

    const grid = section.querySelector<HTMLElement>("#blog-list-grid");
    const filterButtons = section.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cardItems = section.querySelectorAll<HTMLElement>(".blog-card-item");
    const loadMoreBtn = section.querySelector<HTMLButtonElement>("#blog-load-more");

    if (filterButtons.length === 0 || cardItems.length === 0) return;

    const pageSize = Number(grid?.dataset.pageSize) || cardItems.length;

    let currentCategory = "all";
    let visibleCount = pageSize;

    const setActiveButton = (activeButton: HTMLButtonElement) => {
      filterButtons.forEach((button) => {
        const isActive = button === activeButton;
        button.classList.toggle("is-active", isActive);
        button.classList.toggle("bg-primary", isActive);
        button.classList.toggle("text-dark-primary", isActive);
        button.classList.toggle("border-primary", isActive);
        button.classList.toggle("border-stroke", !isActive);
      });
    };

    let refreshTimer: gsap.core.Tween | null = null;

    const scheduleScrollRefresh = () => {
      refreshTimer?.kill();
      refreshTimer = gsap.delayedCall(0.35, () => {
        ScrollTrigger.refresh();
      });
    };

    const getMatchingCards = (selectedCat: string) => Array.from(cardItems).filter((card) => selectedCat === "all" || card.dataset.category === selectedCat);

    const render = (previousVisible: HTMLElement[], animate = true) => {
      const matching = getMatchingCards(currentCategory);
      const toShow = matching.slice(0, visibleCount);
      const toShowSet = new Set(toShow);
      const previousVisibleSet = new Set(previousVisible);
      const newlyShown = toShow.filter((card) => !previousVisibleSet.has(card));

      cardItems.forEach((card) => {
        if (toShowSet.has(card)) return;
        gsap.killTweensOf(card);
        card.style.display = "none";
      });

      toShow.forEach((card) => {
        gsap.killTweensOf(card);
        card.style.display = "block";
      });

      if (animate) {
        const animateTargets = newlyShown.length > 0 ? newlyShown : toShow;
        gsap.fromTo(
          animateTargets,
          { y: 80, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1,
            stagger: 0.15,
            ease: "power3.out",
          },
        );
      }

      if (loadMoreBtn) {
        loadMoreBtn.style.display = matching.length > visibleCount ? "" : "none";
      }

      scheduleScrollRefresh();
    };

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selectedCat = btn.dataset.cat ?? "all";
        if (selectedCat === currentCategory) return;

        setActiveButton(btn);
        currentCategory = selectedCat;
        visibleCount = pageSize;
        render([]);
      });
    });

    loadMoreBtn?.addEventListener("click", () => {
      const previousVisible = getMatchingCards(currentCategory).slice(0, visibleCount);
      visibleCount += pageSize;
      render(previousVisible);
    });

    render([], false);
  }

  initCategoryFilter();
  initScrollAnimation();
  document.addEventListener("astro:page-load", () => {
    initScrollAnimation();
    initCategoryFilter();
  });
</script>
