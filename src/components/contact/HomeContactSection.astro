---
import ContactForm from "@/components/contact/ContactForm.astro";
import { cn } from "@/lib/utils";

const { className } = Astro.props;
---

<div class={cn("pb-15 md:pb-24 lg:pb-40", className)}>
  <div class="container">
    <div class="max-w-xl mx-auto text-center mb-10 sm:mb-16">
      <h2 class="font-jersey text-5xl md:text-6xl lg:text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">
        Ready to bring
        <span class="text-dark-shades-60"> your next idea to life?</span>
      </h2>
    </div>
    <ContactForm />
  </div>
</div>
