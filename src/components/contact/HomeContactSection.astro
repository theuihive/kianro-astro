---
import ContactForm from "@/components/contact/ContactForm.astro";
import { cn } from "@/lib/utils";
import TextReveal from "@/components/ui/TextReveal.astro";

const { className } = Astro.props;
---

<div class={cn("pb-15 md:pb-24 lg:pb-40", className)} id="contact-section">
  <div class="container">
    <div class="max-w-xl mx-auto text-center mb-10 sm:mb-16" id="contact-header">
      <TextReveal>
        Ready to bring
        <span class="text-dark-shades-60"> your next idea to life?</span>
      </TextReveal>
    </div>
    <div id="contact-form">
      <ContactForm />
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initScrollAnimation() {
    const section = document.querySelector("#contact-section");
    if (!section) return;

    const contactForm = section.querySelector("#contact-form");
    if (!contactForm) return;

    gsap.from(contactForm, {
      y: 100,
      scale: 0.9,
      opacity: 0,
      duration: 0.9,
      ease: "power3.out",
      scrollTrigger: {
        trigger: section,
        start: "top 75%",
        toggleActions: "play none none none",
      },
    });
  }

  initScrollAnimation();
  document.addEventListener("astro:page-load", initScrollAnimation);
</script>
