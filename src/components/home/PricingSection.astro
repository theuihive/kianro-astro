---
import pricingData from "@/data/pricing.json";
import CheckIcon from "@/components/icons/CheckIcon.astro";
import Button from "@/components/ui/Button.astro";

import type { PricingData } from "@/types/Pricing";
import BrandsTicker from "@/components/about/BrandsTicker.astro";
import TextReveal from "@/components/ui/TextReveal.astro";

const { heading, billing, plans } = pricingData as PricingData;

const { showBrandsTicker } = Astro.props;
---

<section class="py-15 md:py-24 lg:py-40" id="pricing-section">
  <div class="container">
    <div class="max-w-274 mx-auto">
      <!-- Heading -->
      <div class="mb-11 text-center max-w-3xl mx-auto" id="pricing-header">
        <TextReveal>
          {heading.lineBold}
          <span class="text-dark-shades-60"> {heading.lineMuted}</span>
        </TextReveal>
      </div>

      <!-- Billing switcher -->
      <div data-billing-switcher data-active={billing.default} class="mb-12 flex items-center justify-center gap-4" id="pricing-switcher">
        {
          billing.options.map((option, i) => (
            <>
              {i === 1 && (
                <button
                  type="button"
                  data-billing-toggle
                  role="switch"
                  aria-checked={billing.default === "retainer"}
                  aria-label="Toggle billing period"
                  class="relative h-7.75 w-17 shrink-0 bg-transparent border border-stroke transition-colors duration-300"
                  data-checked={billing.default === "retainer"}
                >
                  <span data-billing-knob class="absolute top-1.5 left-1.5 w-7 h-4.5 bg-primary transition-transform duration-300 data-[checked=true]:translate-x-6" data-checked={billing.default === "retainer"} />
                </button>
              )}
              <button type="button" data-billing-option={option.id} class="flex items-center gap-2 text-base sm:text-xl font-semibold text-white transition-opacity duration-300" data-active={billing.default === option.id}>
                {option.label}
                {option.badge && <span class="text-sm sm:text-lg font-normal">({option.badge})</span>}
              </button>
            </>
          ))
        }
      </div>

      <!-- Plans -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          plans.map((plan) => (
            <div class="relative p-5 sm:p-10 bg-dark-shades-90" id="pricing-card">
              {plan.popular && <span class="absolute right-5 md:right-10 top-5 md:top-15 bg-primary text-dark-primary px-4 md:px-8 py-1 md:py-3 text-sm md:text-xl font-semibold leading-normal tracking-[-1%]">{plan.popularLabel ?? "Popular"}</span>}

              <div class="mb-5 md:mb-9 flex items-center gap-2.5">
                <span class="size-2 shrink-0 bg-primary" aria-hidden="true" />
                <span class="text-xl font-semibold leading-normal tracking-[-1%] text-white">{plan.name}</span>
              </div>

              <div class="mb-3 flex items-end gap-1.5">
                <span class="font-jersey text-5xl md:text-[64px] leading-[90%] tracking-[-3%] text-white" data-price data-plan={plan.id} data-currency={billing.currency} data-project-price={plan.pricing.project} data-retainer-price={plan.pricing.retainer}>
                  {billing.currency}
                  {plan.pricing[billing.default].toLocaleString()}
                </span>
                <span class="pb-1 text-lg font-normal leading-normal tracking-[-1%] text-dark-shades-50">{billing.period}</span>
              </div>

              <p class="mb-8.5 pb-8.5 text-lg font-normal leading-normal tracking-[-1%] text-dark-shades-50 border-b border-stroke">{plan.description}</p>

              <p class="mb-5 text-base font-medium leading-normal tracking-[-1%] text-white">{plan.featuresLabel}</p>

              <ul class="mb-10 flex-1 space-y-3">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2.5">
                    <CheckIcon class="text-primary" />
                    <span class="text-base md:text-xl font-semibold leading-normal tracking-[-1%] text-white">{feature}</span>
                  </li>
                ))}
              </ul>

              {plan.popular ? (
                <Button grow>{plan.cta.label}</Button>
              ) : (
                <Button variant="outline" grow>
                  {plan.cta.label}
                </Button>
              )}
            </div>
          ))
        }
      </div>

      {
        showBrandsTicker && (
          <div class="max-w-162 mx-auto pt-10 sm:pt-25" id="pricing-ticker">
            <BrandsTicker />
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initBillingSwitcher() {
    const section = document.querySelector<HTMLElement>("#pricing-section");
    if (!section) return;

    const wrapper = section.querySelector<HTMLElement>("[data-billing-switcher]");
    const toggle = wrapper?.querySelector<HTMLElement>("[data-billing-toggle]");
    const knob = wrapper?.querySelector<HTMLElement>("[data-billing-knob]");
    const optionButtons = Array.from(wrapper?.querySelectorAll<HTMLElement>("[data-billing-option]") ?? []);
    const prices = Array.from(section.querySelectorAll<HTMLElement>("[data-price]"));

    function setBilling(id: "project" | "retainer") {
      if (!wrapper) return;
      wrapper.dataset.active = id;

      const isRetainer = id === "retainer";
      toggle?.setAttribute("aria-checked", String(isRetainer));
      toggle?.setAttribute("data-checked", String(isRetainer));
      knob?.setAttribute("data-checked", String(isRetainer));

      optionButtons.forEach((btn) => {
        btn.dataset.active = String(btn.dataset.billingOption === id);
      });

      prices.forEach((el) => {
        const value = el.dataset[id === "project" ? "projectPrice" : "retainerPrice"];
        if (!value) return;
        const currencySymbol = el.dataset.currency ?? "$";
        el.textContent = `${currencySymbol}${Number(value).toLocaleString()}`;
      });
    }

    toggle?.addEventListener("click", () => {
      const next = wrapper!.dataset.active === "project" ? "retainer" : "project";
      setBilling(next);
    });

    optionButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.billingOption as "project" | "retainer";
        setBilling(id);
      });
    });

    // ScrollTrigger Animations
    gsap.set(section, { autoAlpha: 1 });

    const header = section.querySelector("#pricing-header");
    const switcher = section.querySelector("#pricing-switcher");
    const cards = section.querySelectorAll("#pricing-card");
    const ticker = section.querySelector("#ricing-ticker");

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });

    // Header Reveal
    if (header) {
      tl.from(header, {
        y: 80,
        opacity: 0,
        filter: "blur(10px)",
        duration: 0.8,
        ease: "power3.out",
      });
    }

    // Billing Switcher Reveal
    if (switcher) {
      tl.from(
        switcher,
        {
          y: 30,
          opacity: 0,
          duration: 0.6,
          ease: "power3.out",
        },
        "-=0.4",
      );
    }

    // Pricing Cards Stagger Reveal
    if (cards.length) {
      tl.from(
        cards,
        {
          y: 60,
          scale: 0.95,
          opacity: 0,
          filter: "blur(10px)",
          duration: 0.8,
          ease: "power4.out",
          stagger: 0.15,
        },
        "-=0.3",
      );
    }

    // Brands Ticker Reveal
    if (ticker) {
      tl.from(
        ticker,
        {
          y: 40,
          opacity: 0,
          filter: "blur(10px)",
          duration: 0.7,
          ease: "power3.out",
        },
        "-=0.3",
      );
    }
  }

  initBillingSwitcher();
  document.addEventListener("astro:page-load", initBillingSwitcher);
</script>
