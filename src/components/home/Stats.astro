---
import BrandsTicker from "@/components/about/BrandsTicker.astro";

interface Stat {
  value: string;
  label: string;
  colStart: string;
  rowStart: string;
}

const stats: Stat[] = [
  { value: "230+", label: "Projects Delivered", colStart: "lg:col-start-3", rowStart: "lg:row-start-1" },
  { value: "98%", label: "Satisfaction Rate", colStart: "lg:col-start-2", rowStart: "lg:row-start-2" },
  { value: "80+", label: "Long-Term Clients", colStart: "lg:col-start-1", rowStart: "lg:row-start-3" },
  { value: "12+", label: "Years Creating", colStart: "lg:col-start-3", rowStart: "lg:row-start-3" },
];

const headingText = "From first conversations to final delivery, every collaboration focuses on creating purposeful design, measurable results, and experiences that leave a lasting impression.";
---

<section id="about-stats-section" class="py-15 md:py-24 lg:py-40 overflow-hidden relative" style="visibility: hidden;">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 lg:gap-4 items-stretch relative">
      <!-- LEFT COLUMN -->
      <div class="about-left-content space-y-10 md:space-y-12 lg:space-y-18 lg:absolute lg:left-0 lg:top-0 lg:max-w-160 xl:max-w-196 z-10 w-full">
        <h2 class="about-heading text-3xl sm:text-[36px] lg:text-[40px] uppercase leading-tight lg:leading-none tracking-[-2%] font-jersey">
          {headingText.split(" ").map((word) => <span class="scrub-word inline-block text-dark-shades-60 transition-colors duration-75">{word}&nbsp;</span>)}
        </h2>

        <div class="about-ticker-wrap w-full lg:max-w-100 xl:max-w-162 overflow-hidden">
          <p class="mb-4 sm:mb-8 text-base sm:text-lg leading-normal text-dark-shades-20">Trusted By 200+ Brands</p>
          <!-- Ticker Track -->
          <BrandsTicker />
        </div>
      </div>

      <!-- Spacer for LG screen absolute layout positioning -->
      <div class="hidden lg:block"></div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[308px_228px_308px] lg:grid-rows-[246px_285px_246px] gap-4 sm:gap-6 lg:gap-0 perspective:1000px mt-0 lg:mt-16">
        {
          stats.map((s) => (
            <div class={`stat-card flex flex-col justify-between bg-dark-shades-90 border border-white/5 p-6 sm:p-8 lg:p-6 w-full min-h-40 sm:min-h-50 lg:min-h-0 lg:h-full transition-shadow duration-500 hover:border-white/20 ${s.colStart} ${s.rowStart}`}>
              <span class="stat-value text-5xl sm:text-[64px] text-white font-jersey tracking-[-3%] leading-[90%]" data-target-value={s.value}>
                0
              </span>
              <span class="stat-label text-base sm:text-lg text-dark-shades-50">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initStatsHeavyScrollAnimation() {
    const section = document.querySelector("#about-stats-section");
    if (!section) return;

    const scrubWords = section.querySelectorAll(".scrub-word");
    const tickerWrap = section.querySelector(".about-ticker-wrap");
    const statCards = section.querySelectorAll(".stat-card");
    const statValues = section.querySelectorAll(".stat-value");

    // Clear visibility hidden
    gsap.set(section, { autoAlpha: 1 });

    // Word-by-Word Scrub Text Color Reveal
    if (scrubWords.length) {
      gsap.to(scrubWords, {
        color: "#FFFFFF",
        stagger: 0.1,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top 70%",
          end: "top 20%",
          scrub: 0.6,
        },
      });
    }

    // Ticker Entrance
    if (tickerWrap) {
      gsap.from(tickerWrap, {
        y: 60,
        opacity: 0,
        filter: "blur(12px)",
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: tickerWrap,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
      });
    }

    // Card Reveal + Number Rolling
    const gridTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 60%",
        toggleActions: "play none none reverse",
      },
    });

    // Card Animation
    gridTimeline.fromTo(
      statCards,
      {
        y: 80,
        rotateX: -25,
        scale: 0.7,
        opacity: 0,
        transformOrigin: "center bottom",
      },
      {
        y: 0,
        rotateX: 0,
        scale: 1,
        opacity: 1,
        duration: 1.1,
        ease: "power4.out",
        stagger: {
          amount: 0.5,
          grid: [3, 3],
          from: "random",
        },
      },
    );

    // Number Counting Animation Synchronized with Reveal
    statValues.forEach((statEl) => {
      const rawValue = statEl.getAttribute("data-target-value") || "";
      const numericMatch = rawValue.match(/\d+/);

      if (numericMatch) {
        const targetNumber = parseInt(numericMatch[0], 10);
        const suffix = rawValue.replace(numericMatch[0], "");

        const counterObj = { val: 0 };

        gridTimeline.to(
          counterObj,
          {
            val: targetNumber,
            duration: 1,
            ease: "power3.out",
            onUpdate: () => {
              statEl.textContent = `${Math.floor(counterObj.val)}${suffix}`;
            },
          },
          "<+=0.2",
        );
      }
    });
  }

  // Execution & Astro Transition compatibility
  initStatsHeavyScrollAnimation();
  document.addEventListener("astro:page-load", initStatsHeavyScrollAnimation);
</script>
