---
import ButtonArrowicon from "@/components/icons/ButtonArrowicon.astro";
import projects from "@/data/projects.json";
---

<section class="pb-41">
  <div class="container">
    <div class="mb-18 text-center max-w-2xl mx-auto">
      <h2 class="font-jersey text-5xl md:text-6xl lg:text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">
        Featured Projects That
        <span class="text-dark-shades-60"> Reflect Strategy, Style & Detail</span>
      </h2>
    </div>

    <!-- Pinned scroll section -->
    <div data-projects-pin class="relative h-[80vh] min-h-150 overflow-hidden">
      {
        projects.map((project, i) => (
          <div data-project-slide class="absolute inset-0 h-full w-full" style={`z-index:${i + 1};`}>
            {/* Background Image — clip-path reveal target */}
            <div data-slide-image class="absolute inset-0 overflow-hidden will-change-[clip-path]">
              <img src={project.backgroundImage} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" loading={i === 0 ? "eager" : "lazy"} />
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/35 to-black/50" />
            </div>

            {/* Meta Content — clip-path reveal target, position stays fixed */}
            <div class="absolute inset-0 z-10 flex h-full items-center px-10 will-change-[clip-path]">
              <div data-slide-meta class="grid w-full grid-cols-2 items-center gap-6 sm:grid-cols-3">
                <div class="flex justify-between gap-5 pr-10">
                  {project.leftMeta.map((m) => (
                    <div class="space-y-1">
                      <p class="text-base font-medium leading-normal uppercase text-dark-shades-50">{m.label}</p>
                      <p class="text-xl font-semibold leading-normal text-white">{m.value}</p>
                    </div>
                  ))}
                </div>

                <div class="hidden sm:block" aria-hidden="true" />

                <div class="flex justify-between gap-5 pl-10">
                  {project.rightMeta.map((m) => (
                    <div class="space-y-1 max-w-52">
                      <p class="text-base font-medium leading-normal uppercase text-dark-shades-50">{m.label}</p>
                      <p class="text-xl font-semibold leading-normal text-white">{m.value}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* Centered Polaroid Card — position stays fixed, clip-path reveal target */}
            <a href={`/projects/${project.slug}`} data-slide-card class="group absolute left-1/2 top-1/2 z-999 w-106 -translate-x-1/2 -translate-y-1/2 bg-white p-1.5 will-change-[clip-path]">
              <div class="w-full overflow-hidden">
                <img src={project.cardImage} alt={project.title} loading={i === 0 ? "eager" : "lazy"} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
              <div class="flex items-center justify-between pt-5 pb-7 px-4">
                <h3 class="text-[40px] font-jersey tracking-[-2%] text-dark-primary uppercase leading-none">{project.title}</h3>
                <div class="text-dark-primary">
                  <ButtonArrowicon class="size-8 -rotate-45" />
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initProjectsScroll() {
    const pinWrapEl = document.querySelector<HTMLElement>("[data-projects-pin]");
    if (!pinWrapEl) return;
    const pinWrap = pinWrapEl;

    const slides = gsap.utils.toArray<HTMLElement>("[data-project-slide]", pinWrap);
    const total = slides.length;
    if (total < 2) return;

    ScrollTrigger.getAll().forEach((st) => {
      if (st.trigger === pinWrap) st.kill();
    });

    const imageTargets = slides.map((slide) => slide.querySelector<HTMLElement>("[data-slide-image]"));
    const metaTargets = slides.map((slide) => slide.querySelector<HTMLElement>("[data-slide-meta]"));
    const cardTargets = slides.map((slide) => slide.querySelector<HTMLElement>("[data-slide-card]"));

    const HIDDEN_CLIP = "inset(100% 0% 0% 0%)";
    const VISIBLE_CLIP = "inset(0% 0% 0% 0%)";

    let rects: { image: DOMRect; meta: DOMRect; card: DOMRect } | null = null;

    function measure() {
      const pinRect = pinWrap.getBoundingClientRect();
      const rel = (r: DOMRect) => ({
        top: r.top - pinRect.top,
        height: r.height,
      });
      const imageEl = imageTargets[0]!;
      const metaEl = metaTargets[0]!;
      const cardEl = cardTargets[0]!;
      rects = {
        image: rel(imageEl.getBoundingClientRect()) as unknown as DOMRect,
        meta: rel(metaEl.getBoundingClientRect()) as unknown as DOMRect,
        card: rel(cardEl.getBoundingClientRect()) as unknown as DOMRect,
      };
    }

    function localClipTop(boundaryY: number, elTop: number, elHeight: number) {
      const pct = ((boundaryY - elTop) / elHeight) * 100;
      return Math.min(100, Math.max(0, pct));
    }

    function applyClip(i: number, boundaryYPercent: number) {
      if (!rects) return;
      const containerHeight = pinWrap.clientHeight;
      const boundaryY = (boundaryYPercent / 100) * containerHeight;

      const imgTop = localClipTop(boundaryY, (rects.image as any).top, (rects.image as any).height);
      const metaTop = localClipTop(boundaryY, (rects.meta as any).top, (rects.meta as any).height);
      const cardTop = localClipTop(boundaryY, (rects.card as any).top, (rects.card as any).height);

      gsap.set(imageTargets[i], { clipPath: `inset(${imgTop}% 0% 0% 0%)` });
      gsap.set(metaTargets[i], { clipPath: `inset(${metaTop}% 0% 0% 0%)` });
      gsap.set(cardTargets[i], { clipPath: `inset(${cardTop}% 0% 0% 0%)` });
    }

    function hideSlide(i: number) {
      gsap.set(slides[i], { autoAlpha: 0 });
      gsap.set(imageTargets[i], { clipPath: HIDDEN_CLIP });
      gsap.set(metaTargets[i], { clipPath: HIDDEN_CLIP });
      gsap.set(cardTargets[i], { clipPath: HIDDEN_CLIP });
    }

    function showSlideBase(i: number) {
      gsap.set(slides[i], { autoAlpha: 1 });
      gsap.set(imageTargets[i], { clipPath: VISIBLE_CLIP });
      gsap.set(metaTargets[i], { clipPath: VISIBLE_CLIP });
      gsap.set(cardTargets[i], { clipPath: VISIBLE_CLIP });
    }

    measure();
    slides.forEach((_, i) => (i === 0 ? showSlideBase(0) : hideSlide(i)));

    const segments = total - 1;

    ScrollTrigger.create({
      trigger: pinWrap,
      start: "top 80px",
      end: () => `+=${segments * 100}%`,
      scrub: true,
      pin: true,
      anticipatePin: 1,
      invalidateOnRefresh: true,
      onRefresh: measure,
      onUpdate: (self) => {
        const raw = self.progress * segments;
        const active = Math.min(Math.floor(raw), segments - 1);
        const segProgress = raw - active;
        const boundaryYPercent = 100 - segProgress * 100;

        slides.forEach((_, i) => {
          if (i === active) {
            gsap.set(slides[i], { autoAlpha: 1 });
            gsap.set(imageTargets[i], { clipPath: VISIBLE_CLIP });
            gsap.set(metaTargets[i], { clipPath: VISIBLE_CLIP });
            gsap.set(cardTargets[i], { clipPath: VISIBLE_CLIP });
          } else if (i === active + 1) {
            gsap.set(slides[i], { autoAlpha: 1 });
            applyClip(i, boundaryYPercent);
          } else {
            hideSlide(i);
          }
        });
      },
    });

    const images = pinWrap.querySelectorAll("img");
    let loaded = 0;
    images.forEach((img) => {
      if (img.complete) {
        loaded++;
      } else {
        img.addEventListener("load", () => {
          loaded++;
          if (loaded === images.length) ScrollTrigger.refresh();
        });
      }
    });
  }

  initProjectsScroll();
  document.addEventListener("astro:page-load", initProjectsScroll);
</script>
