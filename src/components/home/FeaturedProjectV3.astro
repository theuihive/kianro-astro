---
import ButtonArrowicon from "@/components/icons/ButtonArrowicon.astro";

const projects = [
  {
    title: "Bloom Wellness",
    href: "#",
    backgroundImage: "/images/projects/project-01.jpg",
    cardImage: "/images/projects/project-thumbnail-01.jpg",
    leftMeta: [
      { label: "Client", value: "Verde Organics" },
      { label: "Category", value: "Wellness" },
    ],
    rightMeta: [
      { label: "Year", value: "2025" },
      { label: "Services", value: "Brand Identity" },
    ],
  },
  {
    title: "Nova Studio",
    href: "#",
    backgroundImage: "/images/projects/project-02.jpg",
    cardImage: "/images/projects/project-thumbnail-02.jpg",
    leftMeta: [
      { label: "Client", value: "Nova Labs" },
      { label: "Category", value: "Technology" },
    ],
    rightMeta: [
      { label: "Year", value: "2024" },
      { label: "Services", value: "Web Design" },
    ],
  },
  {
    title: "Arc Interiors",
    href: "#",
    backgroundImage: "/images/projects/project-03.jpg",
    cardImage: "/images/projects/project-thumbnail-03.jpg",
    leftMeta: [
      { label: "Client", value: "Arc Studio" },
      { label: "Category", value: "Interior" },
    ],
    rightMeta: [
      { label: "Year", value: "2024" },
      { label: "Services", value: "Art Direction" },
    ],
  },
  {
    title: "Solace Retreat",
    href: "#",
    backgroundImage: "/images/projects/project-04.jpg",
    cardImage: "/images/projects/project-thumbnail-04.jpg",
    leftMeta: [
      { label: "Client", value: "Solace Group" },
      { label: "Category", value: "Hospitality" },
    ],
    rightMeta: [
      { label: "Year", value: "2023" },
      { label: "Services", value: "Full Rebrand" },
    ],
  },
];
---

<section class="pb-41">
  <div class="container">
    <div class="mb-18 text-center max-w-2xl mx-auto">
      <h2 class="font-jersey text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">
        Featured Projects That
        <span class="text-dark-shades-60"> Reflect Strategy, Style & Detail</span>
      </h2>
    </div>

    <!-- Pinned scroll section -->
    <div data-projects-pin class="relative h-[80vh] min-h-150 overflow-hidden">
      {
        projects.map((project, i) => (
          <div data-project-slide class="absolute inset-0 h-full w-full overflow-hidden bg-black will-change-transform" style={`z-index:${i + 1};`}>
            {/* Background Image */}
            <div class="absolute inset-0 overflow-hidden">
              <img src={project.backgroundImage} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" loading={i === 0 ? "eager" : "lazy"} />
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/35 to-black/50" />
            </div>

            {/* Meta Content */}
            <div class="relative z-10 flex h-full items-center px-10">
              <div class="grid w-full grid-cols-2 items-center gap-6 sm:grid-cols-3">
                <div class="flex justify-between gap-5 pr-10">
                  {project.leftMeta.map((m) => (
                    <div class="space-y-1">
                      <p class="text-base font-medium leading-normal uppercase text-dark-shades-50">{m.label}</p>
                      <p class="text-xl font-semibold leading-normal text-white">{m.value}</p>
                    </div>
                  ))}
                </div>

                <div class="hidden sm:block" aria-hidden="true" />

                <div class="flex justify-between gap-5 pl-10">
                  {project.rightMeta.map((m) => (
                    <div class="space-y-1">
                      <p class="text-base font-medium leading-normal uppercase text-dark-shades-50">{m.label}</p>
                      <p class="text-xl font-semibold leading-normal text-white">{m.value}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* Centered Polaroid Card */}
            <a href={project.href} class="group absolute left-1/2 top-1/2 z-20 w-106 -translate-x-1/2 -translate-y-1/2 bg-white p-1.5">
              <div class="w-full overflow-hidden">
                <img src={project.cardImage} alt={project.title} loading={i === 0 ? "eager" : "lazy"} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
              <div class="flex items-center justify-between pt-5 pb-7 px-4">
                <h3 class="text-[40px] font-jersey tracking-[-2%] text-dark-primary uppercase leading-none">{project.title}</h3>
                <div class="text-dark-primary">
                  <ButtonArrowicon class="size-8" />
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initProjectsScroll() {
    const pinWrap = document.querySelector("[data-projects-pin]");
    if (!pinWrap) return;

    const slides = gsap.utils.toArray<HTMLElement>("[data-project-slide]", pinWrap);
    const total = slides.length;
    if (total < 2) return;

    // Clean up previous triggers
    ScrollTrigger.getAll().forEach((st) => {
      if (st.trigger === pinWrap) st.kill();
    });

    // Initial State
    slides.forEach((slide, i) => {
      gsap.set(slide, { yPercent: i === 0 ? 0 : 100 });
    });

    // Linear Timeline linked with Scroll
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: pinWrap,
        start: "top 80px",
        end: () => `+=${(total - 1) * 100}%`,
        scrub: true,
        pin: true,
        anticipatePin: 1,
        invalidateOnRefresh: true,
      },
    });

    slides.forEach((_, i) => {
      if (i === total - 1) return;
      const nextSlide = slides[i + 1];

      tl.to(
        nextSlide,
        {
          yPercent: 0,
          ease: "none",
          duration: 1,
        },
        i,
      );
    });

    // Refresh layout after image load
    const images = pinWrap.querySelectorAll("img");
    let loaded = 0;
    images.forEach((img) => {
      if (img.complete) {
        loaded++;
      } else {
        img.addEventListener("load", () => {
          loaded++;
          if (loaded === images.length) ScrollTrigger.refresh();
        });
      }
    });
  }

  initProjectsScroll();
  document.addEventListener("astro:page-load", initProjectsScroll);
</script>
