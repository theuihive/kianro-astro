---
import FigmaIcon from "@/components/icons/FigmaIcon.astro";
import FramerIcon from "@/components/icons/FramerIcon.astro";
import WebflowIcon from "@/components/icons/WebflowIcon.astro";
import TextReveal from "@/components/ui/TextReveal.astro";

type BrandIcon = "figma" | "webflow" | "framer";

interface Brand {
  icon: BrandIcon;
  label: string;
}

const brands: Brand[] = [
  { icon: "figma", label: "Figma" },
  { icon: "webflow", label: "Webflow" },
  { icon: "framer", label: "Framer" },
];

const icons: Record<BrandIcon, typeof FigmaIcon> = {
  figma: FigmaIcon,
  webflow: WebflowIcon,
  framer: FramerIcon,
};
const COPIES = 4;
---

<div class="grid grid-cols-12 gap-5 md:gap-10 mb-10 md:mb-20 items-center" id="ticker-section">
  <div class="col-span-12 sm:col-span-8 lg:col-span-6">
    <TextReveal>
      Creative solutions built
      <span class="text-dark-shades-60"> around clarity and growth</span>
    </TextReveal>
  </div>

  <div class="col-span-12 sm:col-span-4 lg:col-span-6">
    <div class="relative w-full h-10 sm:ml-auto sm:size-35 overflow-hidden ticker-mask">
      <div class="ticker-wrapper flex flex-row sm:flex-col gap-3">
        {
          Array.from({ length: COPIES }).map(() => (
            <ul role="list" class="ticker-list flex flex-row sm:flex-col gap-3">
              {brands.map((brand) => {
                const Icon = icons[brand.icon];

                return (
                  <li class="inline-flex h-10 items-center justify-center gap-3 bg-dark-shades-90 px-5 text-base text-white whitespace-nowrap">
                    <Icon />
                    <span>{brand.label}</span>
                  </li>
                );
              })}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initTicker = () => {
    const wrapper = document.querySelector<HTMLElement>(".ticker-wrapper");
    const firstList = document.querySelector<HTMLElement>(".ticker-list");

    if (!wrapper || !firstList) return;

    gsap.killTweensOf(wrapper);

    const mm = gsap.matchMedia();

    mm.add(
      {
        isMobile: "(max-width: 639px)",
        isDesktop: "(min-width: 640px)",
      },
      (context) => {
        const { isMobile } = context.conditions as { isMobile: boolean };
        const axis: "x" | "y" = isMobile ? "x" : "y";

        const gapProp = isMobile ? "columnGap" : "rowGap";
        const gap = parseFloat(getComputedStyle(wrapper)[gapProp] || "0");

        const distance = (isMobile ? firstList.getBoundingClientRect().width : firstList.getBoundingClientRect().height) + gap;

        const speedPxPerSec = 30;
        const duration = distance / speedPxPerSec;

        gsap.set(wrapper, { x: 0, y: 0 });

        gsap.to(wrapper, {
          [axis]: `-=${distance}`,
          duration,
          ease: "none",
          repeat: -1,
          modifiers: {
            [axis]: gsap.utils.unitize((value) => {
              const v = parseFloat(value);
              return v % distance;
            }),
          },
        });

        // cleanup when this matchMedia context is no longer active
        return () => {
          gsap.killTweensOf(wrapper);
        };
      },
    );
  };

  initTicker();
  document.addEventListener("astro:page-load", initTicker);
</script>

<style>
  .ticker-mask {
    /* Mobile: horizontal fade */
    mask-image: linear-gradient(to right, transparent 0, black 40px, black calc(100% - 40px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 40px, black calc(100% - 40px), transparent 100%);
  }

  @media (min-width: 640px) {
    .ticker-mask {
      /* sm and up: vertical fade */
      mask-image: linear-gradient(to bottom, transparent 0, black 75px, black calc(100% - 56px), transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 75px, black calc(100% - 56px), transparent 100%);
    }
  }
</style>
