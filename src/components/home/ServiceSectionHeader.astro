---
import FigmaIcon from "@/components/icons/FigmaIcon.astro";
import FramerIcon from "@/components/icons/FramerIcon.astro";
import WebflowIcon from "@/components/icons/WebflowIcon.astro";

type BrandIcon = "figma" | "webflow" | "framer";

interface Brand {
  icon: BrandIcon;
  label: string;
}

const brands: Brand[] = [
  { icon: "figma", label: "Figma" },
  { icon: "webflow", label: "Webflow" },
  { icon: "framer", label: "Framer" },
];

const icons: Record<BrandIcon, typeof FigmaIcon> = {
  figma: FigmaIcon,
  webflow: WebflowIcon,
  framer: FramerIcon,
};
const COPIES = 4;
---

<div class="grid grid-cols-2 gap-10 mb-20 items-center">
  <div>
    <h2 class="font-jersey text-[80px] leading-[80%] tracking-[-4%] uppercase text-white">
      Creative solutions built
      <span class="text-dark-shades-60"> around clarity and growth</span>
    </h2>
  </div>

  <div class="relative ml-auto size-35 overflow-hidden ticker-mask">
    <div class="ticker-wrapper flex flex-col gap-3">
      {
        Array.from({ length: COPIES }).map(() => (
          <ul role="list" class="ticker-list flex flex-col gap-3">
            {brands.map((brand) => {
              const Icon = icons[brand.icon];

              return (
                <li class="inline-flex h-10 items-center justify-center gap-3 bg-dark-shades-90 px-5 text-base text-white whitespace-nowrap">
                  <Icon />
                  <span>{brand.label}</span>
                </li>
              );
            })}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  const initTicker = () => {
    const wrapper = document.querySelector<HTMLElement>(".ticker-wrapper");
    const firstList = document.querySelector<HTMLElement>(".ticker-list");

    if (!wrapper || !firstList) return;

    gsap.killTweensOf(wrapper);

    const gap = parseFloat(getComputedStyle(wrapper).rowGap || "0");
    const distance = firstList.getBoundingClientRect().height + gap;
    const speedPxPerSec = 30;
    const duration = distance / speedPxPerSec;

    gsap.set(wrapper, { y: 0 });

    gsap.to(wrapper, {
      y: `-=${distance}`,
      duration,
      ease: "none",
      repeat: -1,
      modifiers: {
        y: gsap.utils.unitize((value) => {
          const y = parseFloat(value);
          return y % distance;
        }),
      },
    });
  };

  initTicker();
  document.addEventListener("astro:page-load", initTicker);
</script>

<style>
  .ticker-mask {
    mask-image: linear-gradient(to bottom, transparent 0, black 75px, black calc(100% - 56px), transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 75px, black calc(100% - 56px), transparent 100%);
  }
</style>
