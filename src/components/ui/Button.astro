---
import ButtonArrowicon from "@/components/icons/ButtonArrowicon.astro";
import { cn } from "@/lib/utils";

export interface Props {
  href?: string;
  variant?: "solid" | "outline";
  showArrow?: boolean;
  className?: string;
  buttonClass?: string;
  id?: string;
  grow?: boolean;
  size?: "sm" | "md" | "lg";
}

const sizeClasses = {
  sm: {
    wrapper: "h-12 pl-6 pr-1.5 gap-3 text-sm",
    arrow: "size-7",
  },
  md: {
    wrapper: "h-12 pl-5 pr-2.5 gap-2 text-sm",
    arrow: "size-7",
  },
  lg: {
    wrapper: "h-18 pl-10 pr-2.5 gap-5 text-lg",
    arrow: "size-13",
  },
};

const { href, variant = "solid", showArrow = true, className, buttonClass, id, grow, size = "md" } = Astro.props;

const Tag = href ? "a" : "button";

const variantClasses = {
  solid: "bg-primary text-dark-primary group-hover:bg-red-600 group-hover:text-white",
  outline: "bg-transparent border border-[#858C80] text-primary group-hover:bg-primary group-hover:text-white group-hover:border-primary",
};

const arrowVariantClasses = {
  solid: "bg-dark-primary text-white",
  outline: "bg-primary text-white group-hover:bg-black group-hover:text-primary",
};
---

<Tag href={href} class={cn("inline-flex items-center font-semibold uppercase transition-colors duration-300 group", variantClasses[variant], sizeClasses[size].wrapper, buttonClass, className, grow && "w-full justify-between")} id={id}>
  <span class="flex flex-col h-6 overflow-hidden">
    <span class="flex flex-col items-center transition-transform duration-300 group-hover:-translate-y-1/2">
      <span class="leading-6 whitespace-nowrap flex items-center gap-1.5">
        <slot />
      </span>
      <span class="leading-6 whitespace-nowrap flex items-center gap-1.5">
        <slot />
      </span>
    </span>
  </span>

  {
    showArrow && (
      <span class={cn("shrink-0 relative overflow-hidden transition-colors duration-300", arrowVariantClasses[variant], sizeClasses[size].arrow)}>
        <span class="absolute inset-0 flex items-center justify-center transition-all duration-300 group-hover:translate-x-4 group-hover:opacity-0">
          <ButtonArrowicon class="size-5" />
        </span>

        <span class="absolute inset-0 flex items-center justify-center -translate-x-4 opacity-0 invisible transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 group-hover:visible">
          <ButtonArrowicon class="size-5" />
        </span>
      </span>
    )
  }
</Tag>
