---
import Logo from "@/components/header/Logo.astro";
import ButtonArrowicon from "@/components/icons/ButtonArrowicon.astro";
import { siteConfig } from "@/config/site";

const { columns: footerColumns, copyrightText, credit } = siteConfig.footer;

const socialLabels: Record<keyof typeof siteConfig.socials, string> = {
  facebook: "Facebook",
  instagram: "Instagram",
  twitter: "X (Twitter)",
  linkedin: "LinkedIn",
  youtube: "YouTube",
  github: "GitHub",
  dribbble: "Dribbble",
  behance: "Behance",
};

const followLinks = (Object.entries(siteConfig.socials) as [keyof typeof siteConfig.socials, string | undefined][]).filter(([, href]) => !!href).map(([key, href]) => ({ label: socialLabels[key], href: href as string }));

const currentYear = new Date().getFullYear();
---

<footer class="js-footer bg-dark-shades-90 fixed bottom-0 left-0 w-full z-0 overflow-hidden">
  <div class="container">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-12 lg:gap-6 pt-16 pb-16 md:pb-41">
      <!-- Left: Logo + Newsletter -->
      <div class="max-w-100">
        <a href="/" class="inline-block mb-10 md:mb-18">
          <Logo />
        </a>

        <h3 class="text-2xl sm:text-[40px] uppercase tracking-[-2%] leading-none font-jersey mb-8.5">
          <span class="text-white">Join our </span><span class="text-white/40">Newsletter</span>
        </h3>

        <form class="relative flex items-center sm:w-100" id="newsletter-form">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" name="email" type="email" required placeholder="example@gmail.com" class="w-full h-14 pl-4 bg-dark-shades-80 text-base text-dark-shades-50 focus:outline-none transition-colors duration-300" />
          <button type="submit" aria-label="Subscribe" class="shrink-0 absolute right-2 inline-flex items-center justify-center size-10 bg-dark-primary text-white transition-colors duration-300">
            <ButtonArrowicon />
          </button>
        </form>
      </div>

      <!-- Right: Link columns -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 sm:gap-16 lg:gap-24">
        {
          footerColumns.map((column) => (
            <div>
              <h4 class="text-white font-semibold text-xl mb-5.5 leading-none">{column.title}</h4>
              <ul class="flex flex-col gap-3 footer-links">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="group relative inline-flex items-center text-sm font-medium uppercase text-dark-shades-50 transition-colors duration-500 hover:text-white">
                      <span class="absolute -left-4 size-2 bg-primary opacity-0 transition-all duration-500 group-hover:left-0 group-hover:opacity-100" />
                      <span class="transition-transform duration-500 group-hover:translate-x-4">{link.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div class="col-span-2 sm:col-span-1">
          <h4 class="text-white font-semibold text-xl mb-5.5 leading-none">Follow</h4>
          <ul class="flex flex-col gap-3 footer-links">
            {
              followLinks.map((link) => (
                <li>
                  <a href={link.href} class="group relative inline-flex items-center text-sm font-medium uppercase text-dark-shades-50 transition-colors duration-500 hover:text-white">
                    <span class="absolute -left-4 size-2 bg-primary opacity-0 transition-all duration-500 group-hover:left-0 group-hover:opacity-100" />
                    <span class="transition-transform duration-500 group-hover:translate-x-4">{link.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="py-8 border-t border-stroke flex flex-col sm:flex-row items-center justify-between gap-4 text-sm md:text-base text-dark-shades-50">
      <p>&copy; {currentYear} {copyrightText}</p>
      {credit && <p class="flex items-center gap-1.5">{credit}</p>}
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initStickyFooter() {
      const footer = document.querySelector<HTMLElement>(".js-footer");
      const main = document.querySelector<HTMLElement>("main");
      const items = document.querySelectorAll(".footer-links");

      if (!footer || !main) return;

      const updateFooterSpace = () => {
        if (window.innerWidth >= 768) {
          const footerHeight = footer.offsetHeight;
          main.style.marginBottom = `${footerHeight}px`;
          footer.classList.add("fixed", "bottom-0", "left-0", "w-full", "z-0");
        } else {
          main.style.marginBottom = "0px";
          footer.classList.remove("fixed", "bottom-0", "left-0", "w-full", "z-0");
        }
      };

      updateFooterSpace();
      window.addEventListener("resize", updateFooterSpace);

      if (items.length) {
        gsap.set(items, { y: 40, opacity: 0 });

        gsap.to(items, {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "power2.out",
          stagger: 0.1,
          scrollTrigger: {
            trigger: footer,
            start: "top 90%",
            toggleActions: "play none none none",
          },
        });
      }
    }

    initStickyFooter();
    document.addEventListener("astro:page-load", initStickyFooter);

    document.addEventListener("astro:before-swap", () => {
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    });
  </script>
</footer>
