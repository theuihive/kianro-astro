---
import Logo from "../header/Logo.astro";
import ButtonArrowicon from "@/components/icons/ButtonArrowicon.astro";

const pagesLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Pricing", href: "/pricing" },
  { label: "Insights", href: "/insights" },
];

const resourceLinks = [
  { label: "Contact", href: "/contact" },
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms & Conditions", href: "/terms-and-conditions" },
  { label: "Licenses", href: "/licenses" },
  { label: "Changelog", href: "/changelog" },
  { label: "Style Guide", href: "/style-guide" },
];

const followLinks = [
  { label: "Facebook", href: "https://facebook.com" },
  { label: "Instagram", href: "https://instagram.com" },
  { label: "X (Twitter)", href: "https://x.com" },
  { label: "LinkedIn", href: "https://linkedin.com" },
  { label: "Dribbble", href: "https://dribbble.com" },
  { label: "Behance", href: "https://behance.net" },
];

const currentYear = new Date().getFullYear();
---

<!-- <footer class="js-footer fixedd bottom-0 left-0 w-full z-0 bg-secondary pt-15 md:pt-30 overflow-hidden"></footer> -->
<footer class="bg-dark-shades-90">
  <div class="container">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-12 lg:gap-6 pt-16 pb-16 md:pb-41">
      <!-- Left: Logo + Newsletter -->
      <div class="max-w-100">
        <a href="/" class="inline-block mb-16">
          <Logo />
        </a>

        <h3 class="text-2xl sm:text-[40px] uppercase tracking-[-2%] leading-none font-jersey mb-7.5">
          <span class="text-white">Join our </span><span class="text-white/40">Newsletter</span>
        </h3>

        <form class="relative flex items-center sm:w-106" id="newsletter-form">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" name="email" type="email" required placeholder="ethanwalker@gmail.com" class="w-full h-14 pl-4 bg-dark-shades-80 text-base text-dark-shades-50 focus:outline-none transition-colors duration-300" />
          <button type="submit" aria-label="Subscribe" class="shrink-0 absolute right-2 inline-flex items-center justify-center size-10 bg-dark-primary text-white transition-colors duration-300">
            <ButtonArrowicon />
          </button>
        </form>
      </div>

      <!-- Right: Link columns -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 sm:gap-16 lg:gap-24">
        <div>
          <h4 class="text-white font-semibold text-xl mb-5">Pages</h4>
          <ul class="flex flex-col gap-3">
            {
              pagesLinks.map((link) => (
                <li>
                  <a href={link.href} class="inline-flex items-center gap-2 text-sm uppercase font-medium text-dark-shades-50 hover:text-white transition-colors duration-300">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h4 class="text-white font-semibold text-xl mb-5">Resources</h4>
          <ul class="flex flex-col gap-3">
            {
              resourceLinks.map((link) => (
                <li>
                  <a href={link.href} class="inline-flex items-center gap-2 text-sm uppercase font-medium text-dark-shades-50 hover:text-white transition-colors duration-300">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="col-span-2 sm:col-span-1">
          <h4 class="text-white font-semibold text-xl mb-5">Follow</h4>
          <ul class="flex flex-col gap-3">
            {
              followLinks.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm uppercase font-medium text-dark-shades-50 hover:text-white transition-colors duration-300">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="py-8 border-t border-stroke flex flex-col sm:flex-row items-center justify-between gap-4 text-sm md:text-base text-dark-shades-50">
      <p>&copy; {currentYear} Kianro. All Rights Reserved.</p>
      <p class="flex items-center gap-1.5">
        Designed by <span class="text-white">UI Hive</span>
        <span class="mx-1 text-white/20">|</span>
        Powered by <span class="text-white">Astro</span>
      </p>
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initStickyFooter() {
    const footer = document.querySelector<HTMLElement>(".js-footer");
    const main = document.querySelector<HTMLElement>("main");
    const items = document.querySelectorAll(".js-footer-item");

    if (!footer || !main) return;

    const updateFooterSpace = () => {
      if (window.innerWidth >= 768) {
        const footerHeight = footer.offsetHeight;
        main.style.marginBottom = `${footerHeight}px`;
        footer.classList.add("fixed", "bottom-0", "left-0", "w-full", "z-0");
      } else {
        main.style.marginBottom = "0px";
        footer.classList.remove("fixed", "bottom-0", "left-0", "w-full", "z-0");
      }
    };

    updateFooterSpace();
    window.addEventListener("resize", updateFooterSpace);

    if (items.length) {
      gsap.set(items, { y: 40, opacity: 0 });

      gsap.to(items, {
        y: 0,
        opacity: 1,
        duration: 0.8,
        ease: "power2.out",
        stagger: 0.1,
        scrollTrigger: {
          trigger: footer,
          start: "top 90%",
          toggleActions: "play none none reverse",
        },
      });
    }
  }

  initStickyFooter();
  document.addEventListener("astro:page-load", initStickyFooter);

  document.addEventListener("astro:before-swap", () => {
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
  });
</script>
