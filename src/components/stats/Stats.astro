---
import BrandsTicker from "@/components/about/BrandsTicker.astro";

interface Stat {
  value: string;
  label: string;
  colStart: string;
  rowStart: string;
}

const stats: Stat[] = [
  { value: "245+", label: "Projects Delivered", colStart: "lg:col-start-3", rowStart: "lg:row-start-1" },
  { value: "98%", label: "Satisfaction Rate", colStart: "lg:col-start-2", rowStart: "lg:row-start-2" },
  { value: "87+", label: "Long-Term Clients", colStart: "lg:col-start-1", rowStart: "lg:row-start-3" },
  { value: "15+", label: "Years Creating", colStart: "lg:col-start-3", rowStart: "lg:row-start-3" },
];

const headingText = "From first conversations to final delivery, every collaboration focuses on creating purposeful design, measurable results, and experiences that leave a lasting impression.";
---

<section id="about-stats-section" class="py-15 md:py-24 lg:py-40 overflow-hidden relative opacity-0">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 lg:gap-4 items-stretch relative">
      <!-- LEFT COLUMN -->
      <div class="about-left-content space-y-10 md:space-y-12 lg:space-y-18 lg:absolute lg:left-0 lg:top-0 lg:max-w-160 xl:max-w-196 z-10 w-full">
        <h2 class="about-heading text-3xl sm:text-[36px] lg:text-[40px] uppercase leading-tight lg:leading-none tracking-[-2%] font-jersey">
          {headingText.split(" ").map((word) => <span class="scrub-word inline-block text-dark-shades-60 transition-colors duration-75">{word}&nbsp;</span>)}
        </h2>

        <div class="about-ticker-wrap w-full lg:max-w-100 xl:max-w-162 overflow-hidden">
          <p class="mb-4 sm:mb-8 text-base sm:text-lg leading-normal text-dark-shades-20">Trusted By 200+ Brands</p>
          <!-- Ticker Track -->
          <BrandsTicker />
        </div>
      </div>

      <!-- Spacer for LG screen absolute layout positioning -->
      <div class="hidden lg:block"></div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[308px_228px_308px] lg:grid-rows-[246px_285px_246px] gap-4 sm:gap-6 lg:gap-0 perspective:1000px mt-0 lg:mt-16">
        {
          stats.map((s) => (
            <div class={`stat-card flex flex-col justify-between even:items-end sm:even:items-start bg-dark-shades-90 p-6 sm:p-8 lg:p-6 w-full min-h-40 sm:min-h-50 lg:min-h-0 lg:h-full ${s.colStart} ${s.rowStart}`}>
              <span class="stat-wrapper inline-flex text-5xl sm:text-[64px] text-white font-jersey tracking-[-3%] leading-[90%]">
                {[...s.value].map((ch) =>
                  /\d/.test(ch) ? (
                    <span class="odometer-digit inline-block overflow-hidden h-[1em] leading-none align-top">
                      <span class="odometer-track flex flex-col" data-target={ch}>
                        {Array.from({ length: 10 }).map((_, i) => (
                          <span class="odometer-num block h-[1em] leading-none text-center">{i}</span>
                        ))}
                      </span>
                    </span>
                  ) : (
                    <span class="odometer-static inline-block leading-none">{ch}</span>
                  ),
                )}
              </span>
              <span class="stat-label text-base sm:text-lg text-dark-shades-50">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initStatsHeavyScrollAnimation() {
    const section = document.querySelector("#about-stats-section");
    if (!section) return;

    const scrubWords = section.querySelectorAll(".scrub-word");
    const tickerWrap = section.querySelector(".about-ticker-wrap");
    const statCards = section.querySelectorAll(".stat-card");

    // Clear visibility hidden
    gsap.set(section, { autoAlpha: 1 });

    // Word-by-Word Scrub Text Color Reveal
    if (scrubWords.length) {
      gsap.to(scrubWords, {
        color: "#FFFFFF",
        stagger: 0.1,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top 70%",
          end: "top 20%",
          scrub: 0.6,
        },
      });
    }

    // Ticker Entrance
    if (tickerWrap) {
      gsap.from(tickerWrap, {
        y: 60,
        opacity: 0,
        filter: "blur(12px)",
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: tickerWrap,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      });
    }

    // Card Reveal
    const gridTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 60%",
        toggleActions: "play none none none",
      },
    });

    // Card Animation
    gridTimeline.fromTo(
      statCards,
      {
        y: 80,
        rotateX: -25,
        scale: 0.7,
        opacity: 0,
        transformOrigin: "center bottom",
      },
      {
        y: 0,
        rotateX: 0,
        scale: 1,
        opacity: 1,
        duration: 1.1,
        ease: "power4.out",
        stagger: {
          amount: 0.5,
          grid: [3, 3],
          from: "random",
        },
      },
    );

    // Odometer per-digit roll animation
    statCards.forEach((card) => {
      const tracks = card.querySelectorAll(".odometer-track");
      if (!tracks.length) return;

      tracks.forEach((track, i) => {
        const digitWrapper = track.parentElement;
        const firstNum = track.querySelector(".odometer-num");
        const target = parseInt(track.getAttribute("data-target") || "0", 10);
        if (isNaN(target)) return;

        let digitHeight = 1;
        if (firstNum instanceof HTMLElement && firstNum.offsetHeight) {
          digitHeight = firstNum.offsetHeight;
        } else if (digitWrapper instanceof HTMLElement && digitWrapper.offsetHeight) {
          digitHeight = digitWrapper.offsetHeight;
        }

        // Ensure track starts at 0
        gsap.set(track, { y: 0 });

        // Stagger by digit
        gridTimeline.to(
          track,
          {
            y: -Math.round(digitHeight) * target,
            duration: 1.4,
            ease: "power3.out",
          },
          i * 0.08,
        );
      });
    });
  }

  // Execution & Astro Transition compatibility
  initStatsHeavyScrollAnimation();
  document.addEventListener("astro:page-load", initStatsHeavyScrollAnimation);
</script>
