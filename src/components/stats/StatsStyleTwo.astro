---
interface Stat {
  value: string;
  label: string;
}

const stats: Stat[] = [
  { value: "245+", label: "Projects Delivered" },
  { value: "98%", label: "Satisfaction Rate" },
  { value: "87+", label: "Long-Term Clients" },
  { value: "15+", label: "Years Creating" },
];

const headingText = "From first conversations to final delivery, every collaboration focuses on creating purposeful design, measurable results, and experiences that leave a lasting impression.";
---

<section class="pt-15 md:pt-24 lg:pt-40" id="stats-section">
  <div class="container">
    <div class="max-w-4xl mx-auto text-center mb-10 sm:mb-20 xl:px-15">
      <h2 class="text-[40px] uppercase leading-none tracking-[-2%] font-jersey">
        {headingText.split(" ").map((word) => <span class="scrub-word inline-block text-dark-shades-60 transition-colors duration-75">{word}&nbsp;</span>)}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        stats.map((s) => (
          <div class="flex flex-col justify-between even:items-end sm:even:items-start bg-dark-shades-90 p-6 w-full h-40 lg:h-61">
            <span class="stat-wrapper inline-flex text-5xl md:text-[64px] text-white font-jersey tracking-[-3%] leading-[90%]">
              {[...s.value].map((ch) =>
                /\d/.test(ch) ? (
                  <span class="odometer-digit inline-block overflow-hidden h-[1em] leading-none align-top">
                    <span class="odometer-track flex flex-col" data-target={ch}>
                      {Array.from({ length: 10 }).map((_, i) => (
                        <span class="odometer-num block h-[1em] leading-none text-center">{i}</span>
                      ))}
                    </span>
                  </span>
                ) : (
                  <span class="odometer-static inline-block leading-none">{ch}</span>
                ),
              )}
            </span>
            <span class="text-lg text-dark-shades-50">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const initScrollAnimation = () => {
    const section = document.querySelector<HTMLElement>("#stats-section");
    if (!section) return;

    const scrubWords = section.querySelectorAll(".scrub-word");
    const statWrappers = section.querySelectorAll<HTMLElement>(".stat-wrapper");

    gsap.set(section, { autoAlpha: 1 });

    // Word-by-Word Scrub Text Color Reveal
    if (scrubWords.length) {
      gsap.to(scrubWords, {
        color: "#FFFFFF",
        stagger: 0.2,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top 70%",
          end: "top 20%",
          scrub: 0.6,
        },
      });
    }

    // Odometer Roll Animation
    statWrappers.forEach((wrapper) => {
      if (wrapper.dataset.initialized === "true") return;

      const tracks = wrapper.querySelectorAll<HTMLElement>(".odometer-track");
      if (tracks.length === 0) return;

      const tl = gsap.timeline({
        paused: true,
        scrollTrigger: {
          trigger: wrapper,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
      });

      tracks.forEach((track, i) => {
        const digitEl = track.parentElement as HTMLElement;
        const target = parseInt(track.dataset.target || "0", 10);
        const digitHeight = digitEl.offsetHeight;

        tl.to(
          track,
          {
            y: -digitHeight * target,
            duration: 2,
            ease: "power3.out",
          },
          i * 0.08,
        );
      });

      wrapper.dataset.initialized = "true";
    });
  };

  initScrollAnimation();
  document.addEventListener("astro:page-load", initScrollAnimation);
</script>
